# Copia este archivo como .env y rellena los valores reales
# cp .env.example .env

# Contrasena de MySQL (usada por db y backend)
DB_PASSWORD=contrasena_segura

# Clave secreta para firmar los JWT (minimo 32 caracteres)
JWT_SECRET=clave_larga_y_aleatoria_minimo_32_chars

# URL del backend tal como lo ve el navegador del usuario
# En local con Docker: http://localhost:8080/vidanimal
VITE_API_URL=http://localhost:8080/vidanimal

# Clave de la API de ImgBB para subir fotos de animales
# Obtener en: https://api.imgbb.com/
VITE_IMGBB_KEY=tu_clave_imgbb
