# Variables de entorno necesarias para ejecutar Vidanimal con Docker Compose.
# Copia este archivo a .env y rellena los valores antes de hacer docker-compose up.

# Contraseña de MySQL (usada por el contenedor db y el backend)
DB_PASSWORD=tu_contraseña_segura

# Clave secreta para firmar los tokens JWT (mínimo 32 caracteres recomendado)
JWT_SECRET=tu_clave_secreta_jwt

# URL base de la API REST (usada por el frontend en tiempo de compilación)
VITE_API_URL=http://localhost:8080/vidanimal

# Clave de API de ImgBB para la subida de fotografías de animales
# Obtén una clave gratuita en https://api.imgbb.com/
VITE_IMGBB_KEY=tu_clave_imgbb
